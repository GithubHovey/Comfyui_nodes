{
  "_说明": "这个文件只是给人看的模板。deploy.ps1 会直接改写 %APPDATA%\\Comfy Desktop\\settings.json，把下面五个路径换成本机的实际路径，其余键保持原样。",
  "cacheDir": "<Root>\\ComfyUI-Cache\\download-cache",
  "maxCachedDownloads": 1,
  "onAppClose": "quit",
  "modelsDirs": ["<Root>\\ComfyUI-Shared\\models"],
  "inputDir": "<Root>\\ComfyUI-Shared\\input",
  "outputDir": "<Root>\\ComfyUI-Shared\\output",
  "installDir": "<Root>\\ComfyUI-Installs",
  "telemetryEnabled": true,
  "betaFeaturesEnabled": true,
  "useChineseMirrors": true,
  "firstUseCompleted": true
}
